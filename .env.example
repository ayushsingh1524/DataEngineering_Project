# Snowflake connection
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=DE_PROJECT_DB
SNOWFLAKE_SCHEMA=STAGE

# SQL Server running in Docker Desktop on this Mac
# Publish the container port, e.g. -p 1433:1433
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server

# Optional Airflow worker paths (macOS / Linux)
DATA_ENGINEERING_PROJECT_DIR=
PROJECT_PYTHON_EXECUTABLE=
PROJECT_DBT_EXECUTABLE=
